# Build stage
FROM rust:1.93-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace configuration
COPY Cargo.toml Cargo.lock ./

# Copy all crate manifests
COPY crates/ot-core/Cargo.toml ./crates/ot-core/
COPY crates/ot-common/Cargo.toml ./crates/ot-common/
COPY crates/ot-wasm/Cargo.toml ./crates/ot-wasm/
COPY crates/ot-server/Cargo.toml ./crates/ot-server/
COPY crates/ot-server/build.rs ./crates/ot-server/
COPY crates/writebehind-worker/Cargo.toml ./crates/writebehind-worker/
COPY migration/Cargo.toml ./migration/

# Copy proto files (needed for workspace resolution with ot-server)
COPY proto ./proto

# Create dummy source files to cache dependencies
RUN mkdir -p crates/ot-core/src \
    crates/ot-common/src \
    crates/ot-wasm/src \
    crates/ot-server/src \
    crates/writebehind-worker/src \
    migration/src && \
    echo "pub fn main() {}" > crates/ot-core/src/lib.rs && \
    echo "pub fn main() {}" > crates/ot-common/src/lib.rs && \
    echo "pub fn main() {}" > crates/ot-wasm/src/lib.rs && \
    echo "fn main() {}" > crates/ot-server/src/main.rs && \
    echo "fn main() {}" > crates/writebehind-worker/src/main.rs && \
    echo "pub fn main() {}" > migration/src/lib.rs

# Build dependencies (may fail due to dummy files, that's OK)
RUN cargo build -p writebehind-worker --release || true

# Remove dummy source files and build artifacts
RUN rm -rf crates/ot-core/src \
    crates/ot-common/src \
    crates/ot-wasm/src \
    crates/ot-server/src \
    crates/writebehind-worker/src \
    migration/src && \
    rm -f target/release/writebehind-worker \
    target/release/deps/writebehind_worker* \
    target/release/deps/libot_common*

# Copy real source code (only what writebehind-worker needs)
COPY crates/ot-common/src ./crates/ot-common/src
COPY crates/writebehind-worker/src ./crates/writebehind-worker/src

# Build the actual binary (will use cached dependencies)
RUN cargo build -p writebehind-worker --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/writebehind-worker /app/writebehind-worker

# Set permissions
RUN chmod +x /app/writebehind-worker && \
    chown appuser:appuser /app/writebehind-worker

USER appuser

EXPOSE 8810

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8810/health || exit 1

CMD ["/app/writebehind-worker"]
