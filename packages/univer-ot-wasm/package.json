{
    "name": "@univerjs/univer-ot-wasm",
    "type": "module",
    "version": "0.15.0",
    "description": "Rust WASM implementation of Univer Operational Transformation",
    "author": "Univer Team",
    "license": "Apache-2.0",
    "homepage": "https://univer.ai",
    "repository": {
        "type": "git",
        "url": "https://github.com/dream-num/univer.git",
        "directory": "packages-experimental/univer-ot-wasm"
    },
    "bugs": {
        "url": "https://github.com/dream-num/univer/issues"
    },
    "keywords": [
        "univer",
        "operational-transformation",
        "ot",
        "wasm",
        "rust",
        "collaboration"
    ],
    "exports": {
        ".": {
            "node": {
                "types": "./pkg-node/ot_wasm.d.ts",
                "default": "./pkg-node/ot_wasm.js"
            },
            "default": {
                "types": "./pkg/ot_wasm.d.ts",
                "default": "./pkg/ot_wasm.js"
            }
        }
    },
    "main": "pkg/ot_wasm.js",
    "types": "pkg/ot_wasm.d.ts",
    "files": [
        "pkg-node/**/*",
        "pkg/**/*"
    ],
    "scripts": {
        "build": "wasm-pack build crates/ot-wasm --target bundler --out-dir ../../pkg && wasm-pack build crates/ot-wasm --target nodejs --out-dir ../../pkg-node",
        "build:bundler": "wasm-pack build crates/ot-wasm --target bundler --out-dir ../../pkg",
        "build:node": "wasm-pack build crates/ot-wasm --target nodejs --out-dir ../../pkg-node",
        "build:web": "wasm-pack build crates/ot-wasm --target web --out-dir ../../pkg",
        "build:server": "cargo build -p ot-server --release",
        "build:core": "cargo build -p ot-core --release",
        "build:workspace": "cargo build --workspace --release",
        "test": "cargo test --workspace",
        "test:core": "cargo test -p ot-core",
        "test:server": "cargo test -p ot-server",
        "test:web": "wasm-pack test crates/ot-wasm --headless --firefox",
        "test:coverage": "cargo tarpaulin --workspace",
        "dev": "wasm-pack build crates/ot-wasm --target bundler --out-dir ../../pkg --dev",
        "start:server": "cargo r -p ot-server",
        "dev:server": "cargo watch -x 'run --release -p ot-server'",
        "dev:writebehind-worker": "cargo watch -x 'run --release -p writebehind-worker'",
        "clean": "cargo clean && rm -rf pkg pkg-node",
        "lint": "cargo clippy --workspace --all-targets",
        "prepare": "cargo --version && rustc --version"
    },
    "devDependencies": {
        "wasm-pack": "^0.14.0"
    }
}
