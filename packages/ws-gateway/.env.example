# Server
PORT=8080

# Redis
REDIS_URL=redis://localhost:6379

# etcd (service discovery)
ETCD_ENDPOINTS=http://localhost:2379

# gRPC service prefixes (etcd keys)
USER_RPC_PREFIX=user.rpc
DOCUMENT_RPC_PREFIX=document.rpc

# Auth
SKIP_TOKEN_VERIFICATION=false
SKIP_PERMISSION_CHECK=false

# Awareness
AWARENESS_TTL_SECONDS=120
